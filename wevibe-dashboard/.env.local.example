# Copy to .env.local and adjust for your environment.
# These are public (browser-exposed) runtime values; do not put secrets here.

# The organization the dashboard targets by default (a chain org UUID).
NEXT_PUBLIC_ORG_ID=00000000-0000-0000-0000-000000000000

# Chain connection
NEXT_PUBLIC_WEVIBE_CHAIN_ID=wevibe-local-1
NEXT_PUBLIC_WEVIBE_CHAIN_RPC=tcp://localhost:26657
NEXT_PUBLIC_WEVIBE_CHAIN_REST=http://localhost:1317

# Denomination / address prefix
NEXT_PUBLIC_WEVIBE_BECH32_PREFIX=wevibe
NEXT_PUBLIC_WEVIBE_COIN_DENOM=VIBE
NEXT_PUBLIC_WEVIBE_COIN_MIN_DENOM=uvibe
