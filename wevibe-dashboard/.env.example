# WeVibe dashboard runtime config.
# These values are READ AT RUNTIME by the server and injected into the browser.
#
# ONE flag switches every service between localhost and the public hosts:
#   WEVIBE_ENV=local        → localhost URLs (DEFAULT; local-first)
#   WEVIBE_ENV=production    → public hosts (NOT deployed yet — placeholders)
# Precedence: an explicit per-URL var below > the WEVIBE_ENV base default.
# On a VPS, either set WEVIBE_ENV=production or override individual URLs, then
# restart the container (no rebuild).
WEVIBE_ENV=local

# ── Per-URL overrides (optional; each wins over the WEVIBE_ENV base) ────────
# WEVIBE_HUB_URL=http://localhost:4440
# WEVIBE_OLLAMA_URL=http://localhost:11434
# WEVIBE_MCP_URL=http://127.0.0.1:4450
# MCP local HTTP sidecar (dashboard → MCP); must match the MCP's WEVIBE_MCP_HTTP_PORT
# WEVIBE_MCP_HTTP_URL=http://127.0.0.1:4450
# WEVIBE_SOCIAL_GRAPH_URL=http://localhost:4470
# WEVIBE_CHAIN_ID=wevibe-local-1
# WEVIBE_CHAIN_RPC=http://localhost:26657
# WEVIBE_CHAIN_REST=http://localhost:1317
# WEVIBE_BECH32_PREFIX=wevibe
# WEVIBE_COIN_DENOM=VIBE
# WEVIBE_COIN_MIN_DENOM=uvibe

# ── Production URLs — fill real values at VPS deploy, then set ───────────────
# WEVIBE_ENV=production and republish. This is the ONE place to seat the real
# public hosts. Until filled, WEVIBE_ENV=production resolves these to
# unresolvable *.PLACEHOLDER.invalid tokens, so nothing goes live by accident.
# These per-URL vars take PRECEDENCE over the WEVIBE_ENV base.
#   Two-step VPS flip: (1) fill the real URLs below  (2) set WEVIBE_ENV=production → republish
# WEVIBE_HUB_URL=https://hub.PLACEHOLDER.invalid                   # TODO(VPS): real hub host
# WEVIBE_CHAIN_RPC=https://chain-rpc.PLACEHOLDER.invalid           # TODO(VPS): real chain RPC host
# WEVIBE_CHAIN_REST=https://chain-rest.PLACEHOLDER.invalid         # TODO(VPS): real chain REST host
# WEVIBE_SOCIAL_GRAPH_URL=https://social-graph.PLACEHOLDER.invalid # TODO(VPS): real social-graph host
