# WeVibe dashboard runtime config.
# These values are READ AT RUNTIME by the server and injected into the browser.
# On a VPS, set these to public URLs and restart the container (no rebuild).

WEVIBE_HUB_URL=http://localhost:4440
WEVIBE_MCP_URL=http://localhost:4450
WEVIBE_SOCIAL_GRAPH_URL=http://localhost:4470
WEVIBE_CHAIN_ID=wevibe-local-1
WEVIBE_CHAIN_RPC=http://localhost:26657
WEVIBE_CHAIN_REST=http://localhost:1317
WEVIBE_BECH32_PREFIX=wevibe
WEVIBE_COIN_DENOM=VIBE
WEVIBE_COIN_MIN_DENOM=uvibe
