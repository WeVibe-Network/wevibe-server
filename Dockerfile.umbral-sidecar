FROM rust:1.88-bookworm AS builder

WORKDIR /build

COPY wevibe-umbral/Cargo.toml wevibe-umbral/Cargo.lock ./
COPY wevibe-umbral/build.rs ./
COPY wevibe-umbral/proto ./proto
COPY wevibe-umbral/src ./src
COPY wevibe-umbral/crates/core ./crates/core

RUN cargo build --release

FROM debian:bookworm-slim

RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates netcat-openbsd && \
    rm -rf /var/lib/apt/lists/*

COPY --from=builder /build/target/release/wevibe-umbral /usr/local/bin/wevibe-umbral

EXPOSE 4460

CMD ["wevibe-umbral", "serve", "--addr", "0.0.0.0:4460"]
