# =============================================================
# LOCAL DOGFOOD TEMPLATE
# This .env.example is for local Docker Compose dogfood.
# `FAUCET_MNEMONIC` and `WEVIBE_HUB_RESPONSE_SEED` below are DEV-ONLY,
# well-known test values and MUST be replaced with freshly generated
# secrets for any non-local deployment.
# =============================================================

# Deterministic local-dev mnemonic for the standalone faucet service.
# The faucet account is pre-funded in wevibe-chain/scripts/init-chain.sh.
FAUCET_MNEMONIC="legal winner thank year wave sausage worth useful legal winner thank yellow"

# =============================================================
# HOST PORT BIND ADDRESS (network exposure of the Docker stack)
# Default 127.0.0.1 = LOCALHOST-ONLY (browser-direct broadcast still works;
# LAN/internet cannot reach the chain RPC/REST/gRPC, hub, db, etc.).
# For a VPS / public deploy, set to 0.0.0.0 to expose on all interfaces
# (and firewall + reverse-proxy appropriately — see SELF-HOSTING docs).
# This single toggle controls every host port mapping in docker-compose.yml.
# =============================================================
WEVIBE_BIND_HOST=127.0.0.1

# Qdrant API key for local stack services (`wevibe-qdrant`, `wevibe-hub`).
# Leave empty to use docker-compose local default.
WEVIBE_QDRANT_API_KEY=

# Optional local chain epoch length override (seconds).
# Leave empty to use chain/container defaults.
WEVIBE_EPOCH_DURATION_SECONDS=

# =============================================================
# HUB RESPONSE-SIGNING KEY (ed25519 seed, 64 hex chars / 32 bytes)
# The hub signs every response (X-Hub-Signature) with this key; the plugin
# verifies it against the org's on-chain hub_response_pubkey. If UNSET, the hub
# generates an EPHEMERAL key each boot -> the published pubkey churns and recall
# fails to verify. Set a STABLE secret seed in any real deploy. Generate with:
#   openssl rand -hex 32
# The compose default is a throwaway dev seed; DO NOT use it in production.
# =============================================================
WEVIBE_HUB_RESPONSE_SEED=408e6099f9553438066e0f5dc1565314d163837d2db3c3a1ad821da089766a14

# Hub + chain signer secrets used by the compose stack.
# Leave empty for local dogfood defaults; set fresh secrets for non-local deployments.
WEVIBE_CHAIN_SUBMITTER_MNEMONIC=
HUB_NODE_PRIVKEY=

# =============================================================
# DASHBOARD BROWSER-FACING SERVICE URLS (window.__WEVIBE_CONFIG__)
# For VPS / split-host deploys, set these to PUBLIC URLs the browser can reach,
# then run `docker compose up -d` (no rebuild needed; restart picks them up).
# WARNING: WEVIBE_MCP_HTTP_URL is SPECIAL: it is the leader's LOCAL moderation
# MCP (/v1/mod/* REST endpoints; holds the leader's Umbral key). Keep it
# http://localhost:4450 even in production; DO NOT point it at the VPS host.
# =============================================================
WEVIBE_HUB_URL=http://localhost:4440          # Browser-facing hub URL
WEVIBE_MCP_HTTP_URL=http://localhost:4450     # Leader-local moderation MCP REST URL (keep localhost)
WEVIBE_CHAIN_RPC=http://localhost:26657       # Browser-facing chain RPC URL
WEVIBE_CHAIN_REST=http://localhost:1317       # Browser-facing chain REST URL
WEVIBE_SOCIAL_GRAPH_URL=http://localhost:4470 # Browser-facing social graph URL
WEVIBE_CHAIN_ID=wevibe-local-1                # Chain ID
WEVIBE_BECH32_PREFIX=wevibe                   # Bech32 address prefix
WEVIBE_COIN_DENOM=VIBE                        # Display coin denom
WEVIBE_COIN_MIN_DENOM=uvibe                   # Base/minimal coin denom
WEVIBE_ENV=development                        # development | production. Gates production-only verification steps (e.g. recovery-phrase confirmation challenge).

# Leader-local MCP runtime settings.
OLLAMA_HOST=http://host.docker.internal:11434 # Host Ollama endpoint for wevibe-mcp
WEVIBE_KEYSTORE_PATH=/root/.wevibe/keys       # MCP key directory path inside the container
